{
  "name": "betterquest",
  "version": "0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config web/vite.config.ts",
    "dev:extn": "node scripts/watch.mjs",
    "watch": "node scripts/watch.mjs",
    "build": "npm run build:extn && npm run build:site",
    "build:extn": "tsc --noEmit && node scripts/build.mjs",
    "build:site": "npm run site:build && wrangler deploy --dry-run",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "site:build": "vite build --config web/vite.config.ts",
    "site:check": "npm run site:build && wrangler deploy --dry-run",
    "site:dev": "vite --config web/vite.config.ts",
    "site:preview": "npm run site:build && wrangler dev",
    "site:deploy": "npm run site:build && wrangler deploy"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0",
    "vite": "^6.4.4",
    "wrangler": "^4.149.0"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@theme-toggles/react": "^5.0.5",
    "gsap": "^3.15.0",
    "motion": "^14.1.0",
    "next-themes": "^0.4.6",
    "ogl": "^1.0.11",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.180.0"
  }
}
