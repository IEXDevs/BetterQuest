{
  "manifest_version": 3,
  "name": "BetterQuest",
  "version": "1.2.420",
  "description": "A polished Quest workspace with assignment tracking, response tools, dark mode, and local bookmarks.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "tabs"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "BetterQuest",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://quest.cns.utexas.edu/student",
        "https://quest.cns.utexas.edu/student/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "pdf.worker.min.mjs",
        "pdfjs/wasm/*",
        "pdfjs/standard_fonts/*",
        "assets/*",
        "*.png",
        "correct*.png",
        "wrong*.png"
      ],
      "matches": ["https://quest.cns.utexas.edu/*"]
    }
  ]
}
